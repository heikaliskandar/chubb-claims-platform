# Copy to .env on the server, or let ./infra/deploy/server-setup.sh create it with random passwords.

# Public host name. A free one from duckdns.org works, e.g. my-claims.duckdns.org.
DOMAIN=your-name.duckdns.org

# Database passwords: long and random (openssl rand -base64 24). Never reuse them.
POSTGRES_PASSWORD=change-me
CLAIMS_DB_PASSWORD=change-me
INSIGHTS_DB_PASSWORD=change-me

# Password for the demo accounts (claimant1, officer1, lead1, manager1, ...).
# The sign-in page shows "password" as the demo hint, so keep it for a public demo that holds
# only fictional data. Use anything else for a private environment.
DEMO_USER_PASSWORD=password

# true seeds the demo employees and reporting lines (needed for the demo accounts) on first start.
DEMO_DATA_ENABLED=true
# true also seeds nine example claims (one per lifecycle stage) with documents; false starts with no claims.
DEMO_CLAIMS_ENABLED=true

# true serves the interactive API docs at https://<DOMAIN>/api/docs.
API_DOCS_ENABLED=true
